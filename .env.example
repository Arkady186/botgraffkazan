# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Прокси для Telegram (если нужен)
# Примеры:
# TELEGRAM_PROXY=http://user:pass@proxy.com:8080
# TELEGRAM_PROXY=socks5://user:pass@proxy.com:1080
# Оставьте пустым, если прокси не нужен
TELEGRAM_PROXY=

# Адрес хоста и порт для веб-панели
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Путь к базе данных
DATABASE_PATH=data/antidrug.db

# Путь для загрузки медиафайлов
MEDIA_PATH=media

# Секретный ключ для сессий админ-панели (сгенерируйте случайную строку)
SECRET_KEY=change_this_secret_key

# VK сообщество (bots + Long Poll API). Заявки из VK попадают в ту же БД и карту, что Telegram/сайт.
VK_TOKEN=vk1.a.xxxxxx
# Числовой id группы (без минуса)
VK_GROUP_ID=123456789
